# ==============================================================
# Tender Analysis & Extraction Bot - Environment Configuration
# ==============================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database
# Default is zero-configuration SQLite WAL database in storage/
DATABASE_URL=sqlite:///storage/tender_bot.db
# For PostgreSQL: postgresql://username:password@localhost:5432/tender_db

# AI Provider Configuration
# Options: 'hybrid', 'gemini', 'openai', 'rule_based'
AI_PROVIDER=hybrid
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# OCR Configuration
ENABLE_OCR=True
MIN_TEXT_CHARS_PER_PAGE=50
OCR_DPI=300

# Security & Limits
API_KEY_SECRET=your_jwt_or_api_secret_key_here
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=500
ENABLE_AUTH=False
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_secure_password_hash_here

